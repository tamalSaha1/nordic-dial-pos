# Rename this file to .env before running the project

# MongoDB connection string (MongoDB Atlas or local)
# Local example:      mongodb://127.0.0.1:27017/kinetic_ledger
# Atlas example:       mongodb+srv://<user>:<password>@cluster0.xxxxx.mongodb.net/kinetic_ledger
MONGO_URI=mongodb://127.0.0.1:27017/kinetic_ledger

# Secret key used to sign JWT tokens - change this to any long random string
JWT_SECRET=replace_this_with_a_long_random_secret_key

# Port the server runs on
PORT=5000

# Low-stock threshold fallback (used if a product has no reorderLevel set)
DEFAULT_REORDER_LEVEL=10
